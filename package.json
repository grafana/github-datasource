{
  "name": "grafana-github-datasource",
  "version": "2.10.0",
  "private": true,
  "description": "Grafana data source plugin for Github",
  "repository": "github:grafana/github-datasource",
  "license": "Apache-2.0",
  "author": "Grafana Labs <team@grafana.com> (https://grafana.com)",
  "scripts": {
    "build": "webpack -c ./webpack.config.ts --env production",
    "dev": "webpack -w -c ./webpack.config.ts --env development",
    "e2e": "playwright test",
    "lint": "eslint --cache .",
    "lint:fix": "npm run lint -- --fix && prettier --write --list-different .",
    "server": "docker compose up --build",
    "sign": "sign-plugin",
    "spellcheck": "cspell -c cspell.config.json \"**/*.{ts,tsx,js,go,md,mdx,yml,yaml,json,scss,css}\"",
    "test": "jest --watch --onlyChanged",
    "test:ci": "jest --passWithNoTests --maxWorkers 4",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@emotion/css": "11.13.5",
    "@grafana/data": "13.3.0",
    "@grafana/i18n": "13.3.0",
    "@grafana/plugin-ui": "0.17.10",
    "@grafana/runtime": "13.3.0",
    "@grafana/schema": "13.3.0",
    "@grafana/ui": "13.3.0",
    "react": "18.3.1",
    "react-dom": "18.3.1",
    "tslib": "2.9.1"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@babel/core": "7.29.13",
    "@changesets/cli": "3.0.3",
    "@grafana/e2e-selectors": "13.3.0",
    "@grafana/eslint-config": "9.0.0",
    "@grafana/plugin-e2e": "4.0.0",
    "@grafana/plugin-meta-extractor": "0.13.0",
    "@grafana/sign-plugin": "4.0.0",
    "@grafana/tsconfig": "2.2.0",
    "@openfeature/web-sdk": "1.10.0",
    "@playwright/test": "1.65.0",
    "@stylistic/eslint-plugin-ts": "4.4.1",
    "@swc/core": "1.16.22",
    "@swc/helpers": "0.5.24",
    "@swc/jest": "0.2.39",
    "@testing-library/dom": "10.4.2",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.8",
    "@types/jest": "30.0.0",
    "@types/lodash": "4.17.27",
    "@types/node": "25.9.9",
    "@types/react": "18.3.31",
