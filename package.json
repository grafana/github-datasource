    "typescript": "6.0.3",
    "webpack": "5.112.2",
    "webpack-cli": "7.3.1",
    "webpack-livereload-plugin": "3.0.2",
    "webpack-subresource-integrity": "5.1.0",
    "webpack-virtual-modules": "0.6.2"
  },
  "overrides": {
    "basic-ftp": "6.2.6"
  },
  "engines": {
    "node": ">=24",
    "npm": ">=11.17.0"
  },
  "packageManager": "npm@12.2.2"
}
